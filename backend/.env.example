# JSON array; include the Vite development origin when running locally.
BHOOMIDRISHTI_CORS_ORIGINS=["http://localhost:5173"]

# Dotted import path in module:Class form. No predictor is loaded until this is set.
# BHOOMIDRISHTI_PREDICTOR_CLASS=your_model_module:RainPredictor
# BHOOMIDRISHTI_PREDICTOR_KWARGS={}

# Absolute or working-directory-relative paths to real JSON artifacts.
# BHOOMIDRISHTI_METRICS_PATH=artifacts/metrics.json
# BHOOMIDRISHTI_HISTORICAL_EVENTS_PATH=artifacts/historical_events.json
